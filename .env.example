API_HOST=localhost
API_PORT=8080
API_PROTOCOL=http

# Chave Bearer para GET /posts?include=all.
POSTS_API_KEY=

# Endereço de um banco PostgreSQL já criado.
DATABASE_URL=postgresql://postgres:sua_senha@localhost:5432/blog_ai

# Para usar o Gemini 2.5 Flash, defina POST_MODEL=google/gemini-2.5-flash.
POST_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=sua_chave_openai
# GOOGLE_API_KEY=sua_chave_google
